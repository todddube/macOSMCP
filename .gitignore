# Swift / SwiftPM
.build/
.swiftpm/
# Package.resolved IS committed. MacBridge is an application, not a library, so
# pinned dependency versions are what make a build reproducible — and it is the only
# manifest that gives GitHub's dependency graph visibility into what the app actually
# links. While it was ignored, the sole tracked manifest was the retired Python one,
# so every Dependabot alert concerned dead code and none covered the real deps.

# MacBridge.xcodeproj and App/Info.plist ARE committed, so a fresh clone opens and
# builds in Xcode without xcodegen. Both are still generated from project.yml by
# `make project`; commit the regenerated files with the project.yml change.
# Ignore the "MacBridge 2.xcodeproj" copies Xcode leaves behind when the project is
# regenerated while it is open.
MacBridge?*.xcodeproj/

# Xcode local state
*.xcuserdatad/
xcuserdata/

.DS_Store

# Machine-local code signing, written by `make signing` and included by the tracked
# Config/Signing.xcconfig.
Config/Signing.local.xcconfig

# Claude Code: per-machine settings stay local; shared standards are tracked.
.claude/settings.local.json

# Stray xcodebuild output from a run without -derivedDataPath.
build/
