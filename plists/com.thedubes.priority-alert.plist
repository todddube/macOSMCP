<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.thedubes.priority-alert</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>--directory</string>
        <string>/Users/todddube/Documents/Github/macOSMCP</string>
        <string>--extra</string>
        <string>agent</string>
        <string>agents/priority_alert.py</string>
    </array>

    <!-- 11:30 AM and 4:30 PM daily -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>11</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>16</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>IMESSAGE_RECIPIENT</key><string>+18044328850</string>
        <key>HOME</key><string>/Users/todddube</string>
        <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/todddube/Library/Logs/macOSMCP/priority-alert-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/todddube/Library/Logs/macOSMCP/priority-alert-stderr.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
