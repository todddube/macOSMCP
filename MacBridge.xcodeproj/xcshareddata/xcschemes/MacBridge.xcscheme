                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "CFA0103E283A0B033CF5E38D"
                     BuildableName = "MacBridge.app"
                     BlueprintName = "MacBridge"
                     ReferencedContainer = "container:MacBridge.xcodeproj">
