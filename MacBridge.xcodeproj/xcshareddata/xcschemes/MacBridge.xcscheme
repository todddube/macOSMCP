               scriptText = "set -e&#10;SOURCE=&quot;$BUILT_PRODUCTS_DIR/$WRAPPER_NAME&quot;&#10;[ -d &quot;$SOURCE&quot; ] || exit 0&#10;&#10;# Quit the installed copy so its bundle can be replaced safely; a client&#10;# will start the new one again on its next call.&#10;pkill -f &quot;/Applications/MacBridge.app/Contents/MacOS/macbridge$&quot; 2&gt;/dev/null || true&#10;sleep 0.3&#10;&#10;rm -rf /Applications/MacBridge.app&#10;ditto &quot;$SOURCE&quot; /Applications/MacBridge.app&#10;echo &quot;note: installed $(defaults read /Applications/MacBridge.app/Contents/Info CFBundleShortVersionString 2&gt;/dev/null) to /Applications&quot;&#10;">
